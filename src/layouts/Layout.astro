---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import { Image } from 'astro:assets';
import headerImg from '../assets/header.png';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}

const { title, description, image, type, pubDate } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <SEO {title} {description} {image} {type} {pubDate} />
    <ClientRouter />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NKX4LWTHDS"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NKX4LWTHDS');
    </script>
  </head>
  <body class="min-h-screen flex flex-col">

    <header transition:persist class="border-b border-warm-100 sticky top-0 z-50 bg-warm-50/90 backdrop-blur-sm shadow-sm">
      <nav class="mx-auto max-w-3xl px-6 py-5 flex items-center justify-between">
        <a href="/" class="text-sm font-semibold tracking-wide text-navy-900 hover:text-navy-700 transition-colors">
          Christian Sisti
        </a>

        <!-- Desktop nav -->
        <ul class="hidden sm:flex gap-4 sm:gap-6 text-sm text-navy-700">
          <li><a href="/bookshelf" data-navlink class="px-3 py-1.5 rounded-md transition-colors hover:bg-warm-100 hover:text-navy-900">Bookshelf</a></li>
          <li><a href="/trainings" data-navlink class="px-3 py-1.5 rounded-md transition-colors hover:bg-warm-100 hover:text-navy-900">Trainings</a></li>
          <li><a href="/conferences" data-navlink class="px-3 py-1.5 rounded-md transition-colors hover:bg-warm-100 hover:text-navy-900">Conferences</a></li>
          <li><a href="/about" data-navlink class="px-3 py-1.5 rounded-md transition-colors hover:bg-warm-100 hover:text-navy-900">About</a></li>
        </ul>

        <!-- Mobile hamburger button -->
        <button id="menu-btn" class="sm:hidden flex flex-col gap-1.5 p-2 text-navy-700 hover:text-navy-900" aria-label="Toggle menu">
          <span class="block w-5 h-0.5 bg-current transition-all"></span>
          <span class="block w-5 h-0.5 bg-current transition-all"></span>
          <span class="block w-5 h-0.5 bg-current transition-all"></span>
        </button>
      </nav>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden sm:hidden border-t border-warm-100 bg-warm-50">
        <ul class="flex flex-col px-6 py-4 gap-1 text-sm text-navy-700">
          <li><a href="/bookshelf" data-navlink class="block px-3 py-2 rounded-md transition-colors hover:bg-warm-100 hover:text-navy-900">Bookshelf</a></li>
          <li><a href="/trainings" data-navlink class="block px-3 py-2 rounded-md transition-colors hover:bg-warm-100 hover:text-navy-900">Trainings</a></li>
          <li><a href="/conferences" data-navlink class="block px-3 py-2 rounded-md transition-colors hover:bg-warm-100 hover:text-navy-900">Conferences</a></li>
          <li><a href="/about" data-navlink class="block px-3 py-2 rounded-md transition-colors hover:bg-warm-100 hover:text-navy-900">About</a></li>
        </ul>
      </div>
    </header>

    <script>
      function updateNav() {
        const path = window.location.pathname;
        document.querySelectorAll('[data-navlink]').forEach(link => {
          const active = link.getAttribute('href') === path || (path.startsWith('/blog/') && link.getAttribute('href') === '/');
          link.classList.toggle('font-medium', active);
          link.classList.toggle('text-navy-900', active);
          link.classList.toggle('bg-warm-100', active);
        });
      }

      function initMenu() {
        const btn = document.getElementById('menu-btn');
        const menu = document.getElementById('mobile-menu');
        if (!btn || !menu || btn.dataset.init) return;
        btn.dataset.init = 'true';

        btn.addEventListener('click', () => menu.classList.toggle('hidden'));

        // Close on link click
        menu.querySelectorAll('a').forEach(a =>
          a.addEventListener('click', () => menu.classList.add('hidden'))
        );

        // Close on resize to desktop
        window.addEventListener('resize', () => {
          if (window.innerWidth >= 640) menu.classList.add('hidden');
        });
      }

      function closeMenu() {
        document.getElementById('mobile-menu')?.classList.add('hidden');
      }

      updateNav();
      initMenu();
      document.addEventListener('astro:after-swap', () => { updateNav(); closeMenu(); });
    </script>

    <div transition:persist class="w-full">
      <Image
        src={headerImg}
        alt=""
        width={1280}
        quality={90}
        class="w-full object-cover max-h-48 sm:max-h-64"
      />
    </div>

    <main class="mx-auto w-full max-w-3xl px-6 py-10 sm:py-16 flex-1">
      <slot />
    </main>

    <footer class="border-t border-warm-100 py-6">
      <div class="flex flex-col items-center gap-3">
        <a
          href="https://linkedin.com/in/christiansisti/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-xs text-navy-500 hover:text-navy-900 transition-colors"
          aria-label="LinkedIn profile"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
        <p class="text-xs text-warm-300">&copy; {new Date().getFullYear()} Christian Sisti</p>
      </div>
    </footer>

  </body>
</html>
